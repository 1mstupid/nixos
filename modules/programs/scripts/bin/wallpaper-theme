#!/bin/sh

# wallpaper-theme — apply a wallpaper plus a palette generated from it.
# Called by the quickshell wallpaper picker, which does the color extraction
# (Canvas histogram) and passes the derived palette in.
#
# usage: wallpaper-theme <image> <bg> <altbg> <fg> <border> <primary> <secondary> <alert> <disabled> <ansi0..15>

set -u

[ $# -eq 25 ] || {
    echo "usage: wallpaper-theme <image> <8 semantic colors> <16 ansi colors>" >&2
    exit 1
}

CONFIG_DIR="/home/waltz/.config"
CACHE_DIR="$CONFIG_DIR/../.cache/wallpaper-theme"

IMG="$1" BG="$2" ALTBG="$3" FG="$4" BORDER="$5"
PRIMARY="$6" SECONDARY="$7" ALERT="$8" DISABLED="$9"

shift 9

echo "ANSI arguments:"
i=1
for color in "$@"; do
    printf '%s = %s\n' "$i" "$color"
    i=$((i + 1))
done

mkdir -p "$CACHE_DIR" "$CONFIG_DIR/../.cache" "$CONFIG_DIR/../.local/state" "$CONFIG_DIR/gtk-4.0" "$CONFIG_DIR/zapfast/themes"

# Serialize concurrent runs — the last pick wins whole. Spawned daemons
# must not inherit fd 9 or the lock outlives the script.
exec 9>"${XDG_RUNTIME_DIR:-/tmp}/wallpaper-theme.lock"
flock -w 60 9 || echo "wallpaper-theme: lock timeout, proceeding unlocked" >&2

# 1. Polybar/quickshell palette — Theme.qml watches this file and re-colors
#    the bar live the moment it lands.
cat > "$CONFIG_DIR/../.local/state/colors.ini" <<EOF
[colors]
background = $BG
background-alt = $ALTBG
foreground = $FG
primary = $PRIMARY
secondary = $SECONDARY
alert = $ALERT
disabled = $DISABLED
border = $BORDER
EOF

# 2. Alacritty — session-local config dir; live config reload.
#    ~/.config/alacritty is left alone.
cat > "$CACHE_DIR/current-theme.toml" <<EOF
# Generated by wallpaper-theme
# Wallpaper: $(basename "$IMG")

[colors.primary]
foreground = "$FG"
background = "$BG"

[colors.cursor]
text = "$BG"
cursor = "$FG"

[colors.selection]
text = "$FG"
background = "$ALTBG"

[colors.normal]
black   = "$1"
red     = "$2"
green   = "$3"
yellow  = "$4"
blue    = "$5"
magenta = "$6"
cyan    = "$7"
white   = "$8"

[colors.bright]
black   = "$9"
red     = "${10}"
green   = "${11}"
yellow  = "${12}"
blue    = "${13}"
magenta = "${14}"
cyan    = "${15}"
white   = "${16}"
EOF

# 3. Zapfast theme — mapped from semantic + ANSI palette
#    Determine light vs dark base from $BG hex luminance
hex="${BG#\#}"
r=$((16#${hex%????}))
g_b="${hex#??}"
g=$((16#${g_b%??}))
b=$((16#${hex#????}))
luma=$(( (r * 299 + g * 587 + b * 114) / 1000 ))
[ "$luma" -ge 128 ] && BASE_THEME="light" || BASE_THEME="dark"

cat > "$CONFIG_DIR/zapfast/themes/wallpaper.json" <<EOF
{
  "base": "$BASE_THEME",
  "colors": {
    "window": "$BG",
    "panel": "$ALTBG",
    "surface": "$ALTBG",
    "surface_hover": "$9",
    "surface_active": "$BORDER",
    "outline": "$BORDER",
    "text": "$FG",
    "secondary": "$SECONDARY",
    "dim": "$DISABLED",
    "accent": "$PRIMARY",
    "accent_hover": "${13}",
    "on_accent": "$BG",
    "danger": "$ALERT",
    "warning": "$4"
  }
}
EOF

# Helium dashboard — emits a JS palette next to index.html so the
# homepage can live-theme via <script src> (fetch is blocked on
# file:// pages; same-directory script loads are not).

HELIUM_DIR="/home/waltz/Projects/helium"   # <-- wherever index.html lives

mkdir -p "$HELIUM_DIR"

cat > "$HELIUM_DIR/helium-theme.js" <<EOF
/* generated by wallpaper-theme — wallpaper: $(basename "$IMG") */
window.HELIUM_THEME = $(cat "$CONFIG_DIR/zapfast/themes/wallpaper.json");
EOF

# 4. GTK theme — dynamic Wallpaper theme for Helium and GTK3 apps
GTK_THEME_DIR="$HOME/.themes/Wallpaper/gtk-3.0"

mkdir -p "$GTK_THEME_DIR" "$CONFIG_DIR/gtk-4.0"

cat > "$GTK_THEME_DIR/gtk.css" <<EOF
/* Generated by wallpaper-theme */

- {
    color: $FG;
}

window,
.background {
    background-color: $BG;
    color: $FG;
}

headerbar {
    background-color: $BG;
    color: $FG;
}

.sidebar {
    background-color: $ALTBG;
    color: $FG;
}

entry {
    background-color: $ALTBG;
    color: $FG;
    border-color: $BORDER;
    caret-color: $PRIMARY;
}

button {
    background-color: $ALTBG;
    color: $FG;
    border-color: $BORDER;
}

button:hover {
    background-color: $PRIMARY;
    color: $BG;
}

selection,
*:selected {
    background-color: $PRIMARY;
    color: $BG;
}

*:disabled {
    color: $DISABLED;
}
EOF

# GTK4 palette (for applications using GTK4)
cat > "$CONFIG_DIR/gtk-4.0/gtk.css" <<EOF
/* Generated by wallpaper-theme */

@define-color accent_color $PRIMARY;
@define-color accent_bg_color $PRIMARY;
@define-color accent_fg_color $BG;

@define-color window_bg_color $BG;
@define-color window_fg_color $FG;

@define-color view_bg_color $BG;
@define-color view_fg_color $FG;

@define-color headerbar_bg_color $BG;
@define-color headerbar_fg_color $FG;

@define-color sidebar_bg_color $ALTBG;
@define-color sidebar_fg_color $FG;

@define-color card_bg_color $ALTBG;
EOF

# Activate custom theme
gsettings set org.gnome.desktop.interface gtk-theme 'Wallpaper'

# Also configure GTK3 applications that don't use gsettings
cat > "$CONFIG_DIR/gtk-3.0/settings.ini" <<EOF
[Settings]
gtk-theme-name=Wallpaper
gtk-application-prefer-dark-theme=1
EOF

# Also mirror to gtk-3.0 if you use other GTK3 apps that need matching colors
mkdir -p "$CONFIG_DIR/gtk-3.0"
cp "$CONFIG_DIR/gtk-4.0/gtk.css" "$CONFIG_DIR/gtk-3.0/gtk.css"

# 5. Wallpaper now — awww animates the change (the daemon is started by
#    config.conf's exec-once; started here too in case it isn't running).
pgrep -x awww-daemon >/dev/null 2>&1 ||
    { awww-daemon >/dev/null 2>&1 9>&- & sleep 0.5; }

awww img "$IMG" --resize crop --transition-type wipe --transition-angle 30 \
    --transition-fps 60 --transition-duration 1 >/dev/null 2>&1 || true

sed -i "s|^exec-once=awww img .*|exec-once=awww img \"$IMG\" --resize crop|" \
    "$CONFIG_DIR/config.conf"

echo "$IMG" > "$HOME/.cache/mango/current_wallpaper"

"/home/waltz/.local/bin/mango-reload" >/dev/null 2>&1 || true
# 6. Neovim — generate Lua palette from wallpaper colors.
#    Neovim watches this file and reloads the palette live.

NVIM_THEME="/home/waltz/Projects/nvim/lua/colorscheme.lua"
NVIM_THEME_TMP="${NVIM_THEME}.tmp"

cat > "$NVIM_THEME_TMP" <<EOF
local p = {
    background_low = "$BG",
    background = "$ALTBG",
    background_high = "$BORDER",
    background_higher = "$9",
    foreground = "$FG",

    grey = "$DISABLED",
    dark_grey = "$BORDER",

    red = "$ALERT",
    red_dark = "${10}",

    lavender = "$SECONDARY",
    lavender_dark = "${14}",

    moss = "$3",
    moss_dark = "${11}",

    green = "$PRIMARY",
    green_dark = "$3",

    yellow = "$4",
    yellow_dark = "${12}",

    lime = "$PRIMARY",
    lime_dark = "${11}",
}

local M = {}

function M.pick()
    local colorscheme = vim.deepcopy(p)

    colorscheme.terminal = {
        black = "$1",
        red = "$2",
        green = "$3",
        yellow = "$4",
        blue = "$5",
        magenta = "$6",
        cyan = "$7",
        white = "$8",

        bright_black = "$9",
        bright_red = "${10}",
        bright_green = "${11}",
        bright_yellow = "${12}",
        bright_blue = "${13}",
        bright_magenta = "${14}",
        bright_cyan = "${15}",
        bright_white = "${16}",

        background = "$BG",
        foreground = "$FG",
    }

    return colorscheme
end

return M
EOF

mv "$NVIM_THEME_TMP" "$NVIM_THEME"

# Refresh GTK theme application
gsettings set org.gnome.desktop.interface gtk-theme '' 
gsettings set org.gnome.desktop.interface gtk-theme 'Wallpaper' # or your base GTK theme name

sleep 0.5
